# Google Maps Directions API
GOOGLE_MAPS_API_KEY=your_api_key_here

# Home address (origin for commute times)
HOME_ADDRESS=your_home_address_or_place_id

# Destinations (semicolon-separated: Label|Address|mode)
DESTINATIONS=Work|123 Main St;Gym|456 Fitness Ave

# Transit App API (https://transitapp.com/apis -- 5 req/min, 1500/month free)
TRANSIT_APP_API_KEY=your_transit_app_api_key_here
